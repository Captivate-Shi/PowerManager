{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PowerManager",
  "version": "0.2.2",
  "identifier": "io.powermanager.webview2",
  "build": {
    "frontendDist": "../../../dist/ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "payload/collector.exe": "lab/collector.exe"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "parity-hooks.nsh"
      }
    }
  }
}
